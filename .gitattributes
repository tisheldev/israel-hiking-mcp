# Normalise to LF in the repository whatever a contributor's core.autocrlf is
# set to. Working copies still get platform-native endings on checkout; this is
# only about what gets committed, so a Windows clone does not turn every file
# into a whole-file diff.
* text=auto

# Vendored verbatim from creativecommons.org — leave it exactly as fetched.
LICENSE -text

# Generated by uv. A diff of it is noise in review, though it still has to be
# committed and is checked by `uv sync --locked` in CI.
uv.lock linguist-generated=true -diff

# Small enough to read, and the whole point of it is that it is read.
typings/*.pyi linguist-language=Python
